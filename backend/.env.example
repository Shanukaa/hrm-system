# Google Sheets connection
# The ID from your sheet URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=1ilaGe7-8O4de_2j8mz0IQaqexWDQ9chVwee9CRUMydI

# Name of the tab inside the spreadsheet that holds the payroll table
SHEET_NAME=hrm_system

# Row number that contains the specific column titles (EMP NO, OT Pay, EPF 12%, etc.)
# Set to 2 if row 1 is a merged group-label row (e.g. "Company Contribution"
# spanning "EPF 12%" and "ETF 3%") sitting above the real headers.
HEADER_ROW=2

# First row containing actual employee data (usually HEADER_ROW + 1)
DATA_START_ROW=3

# Path to the service account JSON key file (see backend/README.md for how to create it)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Server port
PORT=4000

# Comma-separated list of origins allowed to call this API (your frontend URL)
CORS_ORIGIN=http://localhost:5173

# Company details shown on the payslip letterhead
COMPANY_NAME=Your Company (Pvt) Ltd
COMPANY_ADDRESS=123 Main Street, Negombo, Sri Lanka
COMPANY_LOGO_PATH=./assets/logo.png
