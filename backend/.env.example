# Google Sheets connection
# The ID from your sheet URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=1zqLBymsGYuFWrNo2p13UHZpoociHqyfjazgl4dyjD_o

# Name of the tab inside the spreadsheet that holds the payroll table
SHEET_NAME=Payroll

# Row number that contains the specific column titles (EMP NO, OT Pay, EPF 12%, etc.)
# Set to 2 if row 1 is a merged group-label row (e.g. "Company Contribution"
# spanning "EPF 12%" and "ETF 3%") sitting above the real headers.
HEADER_ROW=2

# First row containing actual employee data (usually HEADER_ROW + 1)
DATA_START_ROW=3

# Path to the service account JSON key file (see backend/README.md for how to create it)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Server port
PORT=4000

# Comma-separated list of origins allowed to call this API (your frontend URL)
CORS_ORIGIN=http://localhost:5173

# Company details shown on the payslip letterhead
COMPANY_NAME=Your Company (Pvt) Ltd
COMPANY_ADDRESS=123 Main Street, Negombo, Sri Lanka
COMPANY_LOGO_PATH=./assets/logo.png

# --- Authentication & user management ---

# Secret used to sign login tokens. MUST be a long random string in production
# (e.g. run `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
# and paste the output here / into Render or Railway's env vars).
JWT_SECRET=change-this-to-a-long-random-string

# How long a login session lasts before the user has to log in again
JWT_EXPIRES_IN=8h

# Names of the (auto-created) tabs used for user accounts and the audit log.
# These live in the SAME spreadsheet as SPREADSHEET_ID above.
USERS_SHEET_NAME=Users
LOGS_SHEET_NAME=Logs

# On first startup, if the Users tab is empty, the server creates one admin
# account automatically using these values so you have a way to log in.
# Change the password after your first login, then feel free to remove
# these two lines (they're only used when no users exist yet).
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-password
