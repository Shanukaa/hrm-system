# --- MySQL connection ---
# Point these at your MySQL database (e.g. Railway's MySQL plugin).
# On Railway: add a MySQL database to your project, open its Variables tab,
# and enable "TCP Proxy" under Networking so it's reachable from Render.
# Then copy MYSQLHOST / MYSQLPORT / MYSQLUSER / MYSQLPASSWORD / MYSQLDATABASE
# (the *public* proxy ones, not the private *.railway.internal ones — Render
# is a separate host and can't reach Railway's private network) into these:
DB_HOST=containers-us-west-000.railway.app
DB_PORT=6543
DB_USER=root
DB_PASSWORD=change-this
DB_NAME=railway
# Set to true only if your host requires SSL (rare for Railway's default plugin)
DB_SSL=false

# Server port
PORT=4000

# Comma-separated list of origins allowed to call this API (your frontend URL)
CORS_ORIGIN=http://localhost:5173

# Company details shown on the payslip letterhead
COMPANY_NAME=Your Company (Pvt) Ltd
COMPANY_ADDRESS=123 Main Street, Negombo, Sri Lanka
COMPANY_LOGO_PATH=./assets/logo.png

# --- Authentication & user management ---

# Secret used to sign login tokens. MUST be a long random string in production
# (e.g. run `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
# and paste the output here / into Render or Railway's env vars).
JWT_SECRET=change-this-to-a-long-random-string

# How long a login session lasts before the user has to log in again
JWT_EXPIRES_IN=8h

# On first startup, if the `users` table is empty, the server creates one
# admin account automatically using these values so you have a way to log in.
# Change the password after your first login, then feel free to remove
# these two lines (they're only used when no users exist yet).
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-password

# --- One-time migration only (npm run migrate-from-sheets) ---
# Only needed temporarily, to pull your existing data out of the old Google
# Sheet and into MySQL. Not used by the app itself — safe to delete once
# you've run the migration script successfully.
SPREADSHEET_ID=1zqLBymsGYuFWrNo2p13UHZpoociHqyfjazgl4dyjD_o
SHEET_NAME=Payroll
HEADER_ROW=2
DATA_START_ROW=3
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# or, on hosts without file uploads:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
